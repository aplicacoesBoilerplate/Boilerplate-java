{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "MCP_DOCKER": {
      "type": "local",
      "command": [
        "docker.exe",
        "mcp",
        "gateway",
        "run",
        "--profile",
        "developer_boilerplate_mcp"
      ],
      "enabled": true
    },
    "pencil": {
      "type": "local",
      "command": [
        "C:\\Users\\gerso\\.pencil\\mcp\\antigravity_ide\\out\\mcp-server-windows-x64.exe",
        "--app",
        "antigravity_ide",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }  
  },
  "experimental": {
    "mcp_timeout": 120000
  }
}
