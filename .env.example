# Portas expostas no host
FRONTEND_PORT=8080
PHPMYADMIN_PORT=8081

# Banco de dados
DB_NAME=boilerplate_java
DB_ROOT_PASSWORD=
DB_APP_USERNAME=boilerplate_app
DB_APP_PASSWORD=

# Seguranca e documentacao
TOKEN_ENCRYPTION_KEY=
OTP_PEPPER=
TOKEN_ISSUER=boilerplate-java-api
DOCS_ENABLED=false
DOC_USERNAME=
DOC_PASSWORD=

# Usuario administrativo inicial
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=BOILERPLATE

# Limites de abuso (opcionais; estes são os defaults seguros)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_REQUESTS=30
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_MAX_TRACKED_KEYS=10000

# Mantenha none fora de um proxy confiavel. O Compose define estes valores internamente.
SERVER_FORWARD_HEADERS_STRATEGY=none
TRUSTED_PROXY_IP_REGEX=

# Integracoes opcionais
GOOGLE_CLIENT_ID=
VITE_DOMAIN_EMAIL=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
