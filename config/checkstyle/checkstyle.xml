<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8"/>

    <module name="TreeWalker">
        <module name="TypeName">
            <property name="tokens" value="CLASS_DEF"/>
            <property name="format" value="^(C|R)[A-Z][a-zA-Z0-9]*$"/>
        </module>
        <module name="TypeName">
            <property name="tokens" value="INTERFACE_DEF"/>
            <property name="format" value="^I[A-Z][a-zA-Z0-9]*$"/>
        </module>
        <module name="TypeName">
            <property name="tokens" value="RECORD_DEF"/>
            <property name="format" value="^R[A-Z][a-zA-Z0-9]*$"/>
        </module>
        <module name="TypeName">
            <property name="tokens" value="ENUM_DEF"/>
            <property name="format" value="^E[A-Z][a-zA-Z0-9]*$"/>
        </module>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^p[A-Z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>
    </module>
</module>
